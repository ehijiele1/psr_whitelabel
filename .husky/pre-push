#!/usr/bin/env sh
# Pre-push hook: run a fast typecheck before pushing to Vercel.
# Catches the same class of parse/syntax errors that have broken the last
# several deploys. If this fails, the push is aborted.
#
# To bypass in an emergency: git push --no-verify

set -e

echo "🔍 Running typecheck before push (catches parse errors before Vercel does)..."
npx tsc --noEmit

echo "✅ Typecheck passed. Proceeding with push."
