# ── Supabase ──────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — NEVER expose to client, server-side only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Paystack ───────────────────────────────────────────────────
# Public key is safe to expose (used in browser for PaystackPop)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Secret key — NEVER expose to client, server-side webhook only
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Webhook secret — For verifying Paystack webhook signatures
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# ── App ────────────────────────────────────────────────────────
# Public base URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── White-label branding (all optional, safe defaults apply) ──
NEXT_PUBLIC_BRAND_NAME=EstateManager
NEXT_PUBLIC_BRAND_SHORT_NAME=EM
NEXT_PUBLIC_BRAND_TAGLINE=Property Management, Made Simple
NEXT_PUBLIC_BRAND_DESCRIPTION=Secure multi-role property management platform for landlords, caretakers and tenants.
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@estatemanager.app
NEXT_PUBLIC_BRAND_SUPPORT_PHONE=
NEXT_PUBLIC_BRAND_SUPPORT_ADDRESS=
NEXT_PUBLIC_BRAND_LEGAL_NAME=EstateManager
NEXT_PUBLIC_BRAND_CURRENCY=NGN
NEXT_PUBLIC_BRAND_CURRENCY_SYMBOL=₦
NEXT_PUBLIC_BRAND_LOCALE=en-NG
NEXT_PUBLIC_BRAND_THEME_COLOR=#0F172A
NEXT_PUBLIC_BRAND_LANDLORD_NAME=The Landlord
NEXT_PUBLIC_BRAND_LANDLORD_TITLE=Landlord
NEXT_PUBLIC_BRAND_PROPERTY_ADDRESS=The Property
NEXT_PUBLIC_BRAND_PROPERTY_DESCRIPTION=The premises described in the Lease

# Server-side brand identifiers
BRAND_SMS_SENDER=EstateManager
BRAND_EMAIL_FROM=EstateManager <no-reply@estatemanager.app>
BRAND_REFERENCE_PREFIX=EM
BRAND_INVITE_PREFIX=EM

# ── Email (Resend) ────────────────────────────────────────────
# API key for sending emails via Resend
RESEND_API_KEY=re_your_resend_api_key_here

# ── SMS (eBulkSMS) ──────────────────────────────────────────────
# API credentials for eBulkSMS
EBULK_SMS_API_KEY=your_ebulk_sms_api_key_here
EBULK_SMS_USERNAME=your_ebulk_sms_username_here
SMS_WEBHOOK_API_KEY=your_sms_webhook_api_key_here

# ── Web Push (VAPID) ──────────────────────────────────────────
# VAPID keys for Web Push notifications.
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ── Security ────────────────────────────────────────────────────
# CSRF secret — Must be 32+ random bytes in production.
# Generate with: openssl rand -base64 32
CSRF_SECRET=your_csrf_secret_here_generate_with_openssl_rand_32

# Setup secret — For initial admin setup (must be strong in production)
SETUP_SECRET=your_strong_setup_secret_here

# ── Rate limiting (Upstash Redis, optional but recommended) ──
# Without these, rate limiting falls back to in-memory (per-instance).
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
