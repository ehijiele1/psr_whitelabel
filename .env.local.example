# ── Supabase ──────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — NEVER expose to client, server-side only
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Paystack ───────────────────────────────────────────────────
# Public key is safe to expose (used in browser for PaystackPop)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_46d83d4877d760e148a943152cdbdaf04154d4e3

# Secret key — NEVER expose to client, server-side webhook only
PAYSTACK_SECRET_KEY=your_secret_key_here

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
